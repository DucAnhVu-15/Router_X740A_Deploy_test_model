# File lớn và sinh ra khi build
build/
__pycache__/
*.pyc
*.pcap
*.pcapng
*.zip
*.joblib
*.ort
*.tmp
*.log

# Báo cáo chứa tên/MAC/IP thiết bị thật của bên thứ ba — giữ ở máy, không đẩy lên
05.Test_model_IDS/BAO_CAO_TEST.md
05.Test_model_IDS/TONG_HOP_CAI_TIEN_DOS_VA_DANH_GIA_TEST.md

# Trong thư mục model chỉ đẩy model.onnx và deploy_config.json (build cần), bỏ csv/png/joblib...
05.Test_model_IDS/model/*/*
!05.Test_model_IDS/model/*/model.onnx
!05.Test_model_IDS/model/*/deploy_config.json

# Gói SDC chạy sẵn trên router cần cả hai model .ort
!04.Test_model_SDC_Router/sdc-native-aarch64/model/native/*.ort
